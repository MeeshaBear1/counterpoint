# Server-side only — the serverless proxy (api/analyze.ts) reads this. Never
# exposed to the client. Without it, the app runs on the local heuristic analyzer.
ANTHROPIC_API_KEY=

# Client build-time. Absolute origin of the deployed /api/analyze endpoint.
# Leave blank for web (same-origin). For the mobile apps, set it to your deployed
# origin (e.g. https://counterpoint.example.com) so live Claude analysis works;
# otherwise mobile falls back to the on-device heuristic.
VITE_API_BASE=
